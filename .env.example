# Server-side only. Never prefix these with NEXT_PUBLIC_.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true = demo/testnet (default if unset), false = live
BINANCE_TESTNET=true
# Base URLs are configurable because Binance has moved its testnet hosts before.
BINANCE_REST_BASE=https://demo-fapi.binance.com
BINANCE_WS_BASE=wss://demo-fstream.binance.com
# Added in Phase 4 (login gate):
# APP_PASSWORD_HASH=
# SESSION_SECRET=

# Public market data (no keys needed). Defaults to live Binance so quotes are real prices.
# Point both at the demo host only after confirming it serves the same paths.
MARKET_REST_BASE=https://fapi.binance.com
NEXT_PUBLIC_MARKET_WS_BASE=wss://fstream.binance.com
